apiVersion: 1
groups:
    - orgId: 1
      name: 1m
      folder: WARNING
      interval: 1m
      rules:
        - uid: cdwmypq2m00e8b
          title: RAM Used
          condition: D
          data:
            - refId: A
              relativeTimeRange:
                from: 21600
                to: 0
              datasourceUid: ddw4kf5ococ8wc
              model:
                datasource:
                    type: prometheus
                    uid: ddw4kf5ococ8wc
                editorMode: code
                exemplar: false
                expr: (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100
                format: time_series
                instant: true
                interval: ""
                intervalFactor: 1
                intervalMs: 15000
                maxDataPoints: 43200
                range: false
                refId: A
                step: 240
            - refId: D
              relativeTimeRange:
                from: 21600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 90
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - D
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: D
                type: threshold
          dashboardUid: rYdddlPWk
          panelId: 16
          noDataState: NoData
          execErrState: Error
          for: 5m
          annotations:
            __dashboardUid__: rYdddlPWk
            __panelId__: "16"
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: fdwmz3am42txcb
          title: CPU Busy
          condition: C
          data:
            - refId: A
              relativeTimeRange:
                from: 21600
                to: 0
              datasourceUid: ddw4kf5ococ8wc
              model:
                datasource:
                    type: prometheus
                    uid: ddw4kf5ococ8wc
                editorMode: code
                exemplar: false
                expr: 100 * (1 - avg(rate(node_cpu_seconds_total{mode="idle", instance="${HOST_IP}:9101"}[5m])))
                instant: true
                interval: ""
                intervalFactor: 1
                intervalMs: 15000
                legendFormat: ""
                maxDataPoints: 43200
                range: false
                refId: A
                step: 240
            - refId: C
              relativeTimeRange:
                from: 21600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 95
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          dashboardUid: rYdddlPWk
          panelId: 20
          noDataState: NoData
          execErrState: Error
          for: 1m
          annotations:
            __dashboardUid__: rYdddlPWk
            __panelId__: "20"
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: cdwna6zfw4l4wd
          title: Backup Failure
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 10800
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: |
                  sum(
                    count_over_time(
                      {filename="/logs/duplicati/duplicati.log", stack="klack.cloud"}
                        |~ "Controller-FailedOperation|BackupHandler-FatalError"
                      [$__auto]
                    )
                  )
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 10800
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          dashboardUid: edwndd5zqtzpcb
          panelId: 1
          noDataState: OK
          execErrState: Error
          for: 0s
          annotations:
            __dashboardUid__: edwndd5zqtzpcb
            __panelId__: "1"
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: y1nrf40hhlz3hc
          title: Offsite Backup Failure
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 93600
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: |
                  sum(
                    count_over_time(
                      {filename="/logs/rclone/rclone.log"}
                        |= "RCLONE_BACKUP_RESULT status=FAILED"
                      [$__auto]
                    )
                  )
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 93600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: OK
          execErrState: Error
          for: 0s
          annotations:
            summary: "The nightly offsite rclone backup (/storage/backups -> koofr) failed. Check /var/log/rclone/rclone.log for details -- if the log shows reason=destination_full, the koofr remote is out of space."
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: dupllocalfail0001
          title: Local Backup Failure
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 10800
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: |
                  sum(
                    count_over_time(
                      {filename="/logs/duplicati/duplicati.log", stack="local"}
                        |~ "Controller-FailedOperation|BackupHandler-FatalError"
                      [$__auto]
                    )
                  )
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 10800
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: OK
          execErrState: Error
          for: 0s
          annotations:
            summary: "The Duplicati backup on klack-prime (the local Windows host) failed. Its log ships to Loki as stack=local; query {stack='local'} in Grafana, or read the duplicati logs folder under dockerapps on that machine."
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: duplstaleremote01
          title: Backup Stale
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 93600
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: |
                  sum(
                    count_over_time(
                      {filename="/logs/duplicati/duplicati.log", stack="klack.cloud"}
                        |= "The operation Backup has completed"
                      [26h]
                    )
                  )
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 93600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 1
                        type: lt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Error
          for: 0s
          annotations:
            summary: "No successful Duplicati backup on templeofbytes in the last 26 hours. This host normally completes 6 backups a day, so a full day of silence means backups stopped rather than ran late."
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: dupljobfailed0001
          title: Duplicati Job Failed
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: 'sum by (job_name) (count_over_time({stack="local"} |= "JobStatus" | regexp `job="(?P<job_name>[^"]+)".*result=(?P<result>[^ ]+)` | result != "Success" [30m]))'
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: OK
          execErrState: Error
          for: 0s
          annotations:
            summary: "A Duplicati job on klack-prime last finished with a non-Success result. The job name is in the job_name label. Emitted by job-status.sh every 15 minutes from each job database."
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
        - uid: dupljobstale00001
          title: Duplicati Job Stale
          condition: C
          data:
            - refId: A
              queryType: instant
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: fdw4k6iv40fswd
              model:
                editorMode: code
                expr: 'max by (job_name) (max_over_time({stack="local"} |= "JobStatus" | regexp `job="(?P<job_name>[^"]+)".*age_hours=(?P<age>[-0-9.]+)` | unwrap age [30m]))'
                intervalMs: 1000
                maxDataPoints: 43200
                queryType: instant
                refId: A
            - refId: C
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 26
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Error
          for: 0s
          annotations:
            summary: "A Duplicati job on klack-prime has not had a successful run in over 26 hours. Measured from the last run result, not the last fileset -- an unchanged source writes no fileset yet is healthy. NoData here means job-status.sh itself stopped reporting."
          labels: {}
          isPaused: false
          notification_settings:
            receiver: notify
